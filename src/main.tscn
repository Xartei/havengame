[sub_resource type="GDScript" id="GDScript_1bvp3"]
resource_name = "playerMovement"
script/source = "extends CharacterBody2D

const SPEED := 300.0
const JUMP_VELOCITY := -320.0

@export var swing_angle := -90.0     # max sweep to the left, in degrees
@export var swing_speed := 12.0     # rad/s while ui_accept is held
@export var return_speed := 18.0    # rad/s while returning to rest
@export var kick_launch := 0.2      # extra pop; total launch multiplier is (1.0 + kick_launch)
@export var kick_friction := 0.3    # tangential slip dragged along
@export var kick_charge := true     # scale kick force by how far the swing has travelled
@export var kick_charge_min := 0.0  # force fraction at 0 degrees (0 = linear from nothing)
var base_gravity = ProjectSettings.get_setting(\"physics/2d/default_gravity\") # gravity
var gravity = base_gravity

@onready var kick_pivot: Node2D = $kickPivot
@onready var shoe_area: Area2D = $kickPivot/shoeArea
@onready var shoe_polygon: CollisionPolygon2D = $kickPivot/shoeArea/shape

var _prev_rot := 0.0
var _omega := 0.0


func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += Vector2.DOWN * gravity * delta
		if Input.is_action_pressed(\"up\"):
			gravity = base_gravity * 0.3 # float :v
		elif Input.is_action_pressed(\"down\"):
			gravity = base_gravity * 2 # yeah fall faster with down i always hated you couldnt do this in games loñ
		else:
			gravity = base_gravity

	# handle jump (press and hold).
	if Input.is_action_just_pressed(\"up\") and is_on_floor():
		velocity.y = JUMP_VELOCITY
		gravity = base_gravity

	# Get the input direction and handle the movement/deceleration.
	var direction := Input.get_axis(\"left\", \"right\")
	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	move_and_slide()

	# Press and hold ui_accept to keep sweeping the shoe left; release to return.
	_swing(delta)

	# Angular velocity of the shoe swing (rad/s) for this frame.
	_omega = (kick_pivot.rotation - _prev_rot) / delta
	_prev_rot = kick_pivot.rotation

	# Kick anything the shoe polygon overlaps while the shoe is actually moving.
	# Tested directly against the shoe polygon so the result is frame-accurate;
	# Area2D.get_overlapping_bodies() is one physics tick stale and misses fast sweeps.
	if absf(_omega) > 0.01:
		for body in get_tree().get_nodes_in_group(\"ball\"):
			if body is RigidBody2D and _shoe_overlaps(body as Node2D):
				_kick(body as RigidBody2D)


func _swing(delta: float) -> void:
	var holding := Input.is_action_pressed(\"ui_accept\")
	var target := deg_to_rad(-swing_angle) if holding else 0.0
	var speed := swing_speed if holding else return_speed
	kick_pivot.rotation = move_toward(kick_pivot.rotation, target, speed * delta)


func _kick(ball: RigidBody2D) -> void:
	# Surface velocity of the shoe at the contact: v = omega x r
	var r := ball.global_position - kick_pivot.global_position
	var v_shoe := Vector2(-_omega * r.y, _omega * r.x)

	var n := _shoe_contact_normal(ball.global_position)
	if n == Vector2.ZERO:
		return

	var v_rel := ball.linear_velocity - v_shoe
	var v_n := v_rel.dot(n)
	if v_n >= 0.0:
		return

	ball.linear_velocity -= _kick_power() * (1.0 + kick_launch) * v_n * n
	var v_t := v_rel - v_n * n
	ball.linear_velocity -= kick_friction * v_t


func _kick_power() -> float:
	if not kick_charge:
		return 1.0
	var max_angle := absf(deg_to_rad(-swing_angle))
	if max_angle <= 0.0001:
		return 1.0
	var progress := clampf(absf(kick_pivot.rotation) / max_angle, 0.0, 1.0)
	return lerpf(kick_charge_min, 1.0, progress)


func _shoe_overlaps(ball: Node2D) -> bool:
	var xf := shoe_polygon.global_transform
	var local := xf.affine_inverse() * ball.global_position
	var sx := xf.get_scale().x
	var radius := _ball_radius(ball) / maxf(absf(sx), 0.0001)
	var pts := shoe_polygon.polygon
	if Geometry2D.is_point_in_polygon(local, pts):
		return true
	var count := pts.size()
	for i in count:
		var a := pts[i]
		var b := pts[(i + 1) % count]
		if Geometry2D.get_closest_point_to_segment(local, a, b).distance_squared_to(local) <= radius * radius:
			return true
	return false


func _ball_radius(ball: Node2D) -> float:
	var cs := ball.get_node_or_null(\"hitbox\") as CollisionShape2D
	if cs and cs.shape is CircleShape2D:
		return (cs.shape as CircleShape2D).radius
	return 16.0


func _shoe_contact_normal(point: Vector2) -> Vector2:
	var xf := shoe_polygon.global_transform
	var local := xf.affine_inverse() * point
	var pts := shoe_polygon.polygon
	var count := pts.size()
	var best := Vector2.ZERO
	var best_dist := INF
	for i in count:
		var a := pts[i]
		var b := pts[(i + 1) % count]
		var p := Geometry2D.get_closest_point_to_segment(local, a, b)
		var d := local.distance_squared_to(p)
		if d < best_dist:
			best_dist = d
			best = p
	var dir := local - best
	if Geometry2D.is_point_in_polygon(local, pts):
		dir = -dir
	if dir.length_squared() < 0.0001:
		return Vector2.ZERO
	return xf.basis_xform(dir).normalized()
"

