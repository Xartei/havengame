[sub_resource type="GDScript" id="GDScript_7mycd"]
resource_name = "ballPhysics"
script/source = "extends RigidBody2D

# Inspector Constants
@export var bounce_coefficient: float = 0.75       # Elasticity (0 = none, 1 = perfect)
@export var bounce_speed_threshold: float = 150.0  # Bounces slower than this are weak
@export var min_bounce_impulse: float = 50.0       # Upward kick for weak floor bounces
@export var wall_impulse: float = 10.0             # Small reaction push off walls

var _touching_floor: bool = false
var _touching_wall: bool = false


func _ready() -> void:
	# Contact tracking is required to read collision normals in _integrate_forces
	contact_monitor = true
	max_contacts_reported = 8
	can_sleep = false  # Keeps the ball from freezing when it slows down

	# Normal 0.75 elasticity bounce
	var mat := PhysicsMaterial.new()
	mat.bounce = bounce_coefficient
	mat.friction = 0.2
	physics_material_override = mat


func _integrate_forces(state: PhysicsDirectBodyState2D) -> void:
	# smol newton-style push away from a wall, once per wall touch.
	var wall_push := _wall_push(state)
	if wall_push != Vector2.ZERO and not _touching_wall:
		state.apply_central_impulse(wall_push * wall_impulse)
	_touching_wall = wall_push != Vector2.ZERO

	# Floor bounce only on a clean landing, never while squeezed between bodies.
	var on_floor := _floor_normal(state) != Vector2.ZERO
	if on_floor and not _touching_floor:
		var clean := state.get_contact_count() <= 2 and not _has_downward_contact(state)
		if clean and state.linear_velocity.length() < bounce_speed_threshold:
			state.apply_central_impulse(Vector2(0.0, -min_bounce_impulse))
	_touching_floor = on_floor


func _floor_normal(state: PhysicsDirectBodyState2D) -> Vector2:
	var center: Vector2 = state.center_of_mass
	for i in state.get_contact_count():
		if not _is_boundary(state, i):
			continue
		var normal: Vector2 = state.get_contact_local_normal(i)
		var point: Vector2 = state.get_contact_local_position(i)
		# A floor contact sits below the ball center and has a vertical normal
		if absf(normal.y) > 0.7 and point.y > center.y:
			return normal
	return Vector2.ZERO


func _wall_push(state: PhysicsDirectBodyState2D) -> Vector2:
	var center: Vector2 = state.center_of_mass
	var horizontal := Vector2.ZERO
	for i in state.get_contact_count():
		if not _is_boundary(state, i):
			continue
		var normal: Vector2 = state.get_contact_local_normal(i)
		var point: Vector2 = state.get_contact_local_position(i)
		# Vertical wall (left/right) takes priority and pushes away from whichever side.
		if absf(normal.x) > 0.7:
			return Vector2(-signf(point.x - center.x), 0.0)
		# Horizontal wall (floor/roof) fallback: remember it in case no vertical wall.
		if absf(normal.y) > 0.7 and horizontal == Vector2.ZERO:
			horizontal = Vector2(0.0, -signf(point.y - center.y))
	return horizontal


func _is_boundary(state: PhysicsDirectBodyState2D, contact_idx: int) -> bool:
	# Only the arena boundary (a StaticBody2D) drives bounce/wall behaviour.
	return state.get_contact_collider_object(contact_idx) is StaticBody2D


func _has_downward_contact(state: PhysicsDirectBodyState2D) -> bool:
	for i in state.get_contact_count():
		if state.get_contact_local_normal(i).y > 0.7:
			return true
	return false
"

